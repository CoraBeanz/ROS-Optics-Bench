	(text "Carrier for the ESP32 Feather V2, four TMC2209 breakouts and the ADS1115.\nPins match firmware/optics_bench/config.h. Wiring: electronics/wiring.md."
		(exclude_from_sim no)
		(at 20.32 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "01988b35-2596-572c-97e6-440081a055d0")
	)
	(text "12 V motor supply: PTC fuse, series Schottky (reverse polarity), TVS, bulk capacitor"
		(exclude_from_sim no)
		(at 20.32 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9432c3a5-f16a-5b41-9e79-d375efc71a7a")
	)
	(text "Off-board: laser, photodiode amp boards (1:1 JST-XH cables), test header"
		(exclude_from_sim no)
		(at 144.78 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d5d111a1-8a7c-5918-855a-2a83fa6164b2")
	)
	(text "Driver UART addresses from MS1/MS2: U1 0, U2 1, U3 2, U4 3.\nThe breakouts keep their screw terminals: motors wire straight into them, and\nJ1-J4 feed each breakout's VM +/- terminals over a short 2-wire lead."
		(exclude_from_sim no)
		(at 175.26 17.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "cac9a3aa-cca6-535e-8514-7483c5ff17d0")
	)
	(text "TX reaches the shared single-wire UART bus through R1; RX joins it directly.\nDIAG outputs go to input-only pins I34/I39/I36/I37 (firmware does not use them yet)."
		(exclude_from_sim no)
		(at 50.8 60.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "06d35070-4a95-546a-b6c7-5e7f891ded26")
	)
